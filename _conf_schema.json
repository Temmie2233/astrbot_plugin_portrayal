{
    "llm": {
        "description": "LLM配置",
        "type": "object",
        "items": {
            "provider_id": {
                "description": "用于分析画像的LLM提供商",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商",
                "type": "string",
                "default": "",
                "_special": "select_provider"
            },
            "retry_times": {
                "description": "LLM调用失败重试次数",
                "type": "int",
                "hint": "LLM调用失败时, 重试的次数",
                "slider": {
                    "min": 1,
                    "max": 5,
                    "step": 1
                },
                "default": 2
            }
        }
    },
    "message": {
        "description": "消息查询配置",
        "type": "object",
        "items": {
            "default_query_rounds": {
                "description": "获取群消息的默认轮询次数",
                "type": "int",
                "hint": "每轮固定获取200条群消息, 此处指定轮询多少次。也可用命令 “画像 @群友 轮数” 可实时指定轮数",
                "slider": {
                    "min": 1,
                    "max": 100,
                    "step": 5
                },
                "default": 30
            },
            "max_msg_count": {
                "description": "用于分析的最大消息量(条)",
                "type": "int",
                "hint": "轮询过程中， 获取的群消息数提前达到了最大消息量时，中断轮询。注意：用于分析的消息量越多, 画像越准确, 但需要消耗更多时间和Token",
                "slider": {
                    "min": 100,
                    "max": 1000,
                    "step": 10
                },
                "default": 500
            },
            "cache_ttl_min": {
                "description": "消息缓存的过期时长(分钟)",
                "type": "int",
                "hint": "查询群消息时，会将查询到的消息缓存一段时间方便下次快速取用。此处定义缓存过久过期, 单位为分钟，过期后清除缓存的消息",
                "slider": {
                    "min": 1,
                    "max": 1440,
                    "step": 1
                },
                "default": 120
            },
            "protected_user_ids": {
                "description": "受保护用户名单",
                "type": "list",
                "hint": "填写QQ号。名单中的用户不允许被查询消息",
                "default": []
            }
        }
    },
    "inject_prompt": {
        "description": "给提示词注入画像",
        "type": "bool",
        "hint": "打开后，每轮对话中，若本地存有当前用户的画像，则自动将该用户画像注入到系统提示词中",
        "default": false
    },
    "sync_bot_profile": {
        "description": "切换人格时同步 bot 昵称/头像",
        "type": "bool",
        "hint": "开启后，切换人格会把 bot 的 QQ 昵称和头像改成目标群友的。注意这是账号级全局生效，会影响所有群；默认关闭。",
        "default": false
    },
    "delete_clone_persona_on_restore": {
        "description": "恢复人格时删除克隆人格",
        "type": "bool",
        "hint": "开启后，执行「恢复人格」会同时删除本次切换使用的克隆人格，避免人格库残留。默认关闭。",
        "default": false
    },
    "limits": {
        "description": "使用限制",
        "type": "object",
        "hint": "控制画像生成的冷却、每日次数、缓存复用和并发。0 表示不限制（并发上限除外）。",
        "items": {
            "cooldown_seconds": {
                "description": "每用户冷却（秒）",
                "type": "int",
                "hint": "同一用户两次成功生成画像之间至少间隔多少秒；0 表示不限制。管理员默认豁免。",
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 60
                },
                "default": 600
            },
            "daily_limit": {
                "description": "每用户每日次数",
                "type": "int",
                "hint": "每个用户每天最多成功生成多少次画像（所有生成命令共用）；0 表示不限制。",
                "slider": {
                    "min": 0,
                    "max": 50,
                    "step": 1
                },
                "default": 5
            },
            "target_daily_limit": {
                "description": "同一目标每日次数",
                "type": "int",
                "hint": "同一用户每天最多查询同一目标多少次；0 表示不限制。用于防止针对同一人的反复画像。",
                "slider": {
                    "min": 0,
                    "max": 20,
                    "step": 1
                },
                "default": 2
            },
            "reuse_hours": {
                "description": "画像缓存复用（小时）",
                "type": "int",
                "hint": "同一目标同一类型在多少小时内直接返回缓存结果，不重新扫群和调用 LLM；0 表示不复用。管理员可用「强制」刷新。",
                "slider": {
                    "min": 0,
                    "max": 168,
                    "step": 1
                },
                "default": 12
            },
            "group_concurrency": {
                "description": "每群并发上限",
                "type": "int",
                "hint": "同一个群同时最多运行几个画像任务，超出的排队。默认 1。",
                "slider": {
                    "min": 1,
                    "max": 5,
                    "step": 1
                },
                "default": 1
            },
            "global_concurrency": {
                "description": "全局并发上限",
                "type": "int",
                "hint": "所有群同时最多运行几个画像任务。默认 2。",
                "slider": {
                    "min": 1,
                    "max": 10,
                    "step": 1
                },
                "default": 2
            },
            "admin_exempt": {
                "description": "管理员豁免限制",
                "type": "bool",
                "hint": "开启后管理员不受冷却、每日次数和同目标次数限制；并发限制仍然生效。",
                "default": true
            }
        }
    },
    "media": {
        "description": "图片/表情包分析",
        "type": "object",
        "hint": "克隆时分析目标用户发送的图片/表情包，并自动同步到 meme_manager 的 persona 图包。",
        "items": {
            "enable": {
                "description": "启用图片/表情包分析",
                "type": "bool",
                "hint": "开启后会采集目标用户的图片、商城表情和 QQ 表情，并用图像模型生成简短描述；关闭后只分析文本。",
                "default": true
            },
            "max_images": {
                "description": "每次最多描述图片数",
                "type": "int",
                "hint": "每次画像/克隆最多为多少张图片或表情包生成描述；0 表示不调用视觉模型。",
                "slider": {"min": 0, "max": 50, "step": 1},
                "default": 20
            },
            "max_age_hours": {
                "description": "只处理最近多少小时的图片",
                "type": "int",
                "hint": "QQ 历史图片链接会过期；超过该时长的图片不再下载/描述/入包，避免 404。0 表示不限制。",
                "slider": {"min": 0, "max": 168, "step": 1},
                "default": 24
            },
            "caption_provider_id": {
                "description": "图片描述模型",
                "type": "string",
                "_special": "select_provider",
                "hint": "留空时使用 AstrBot「配置 → 其他设置」里的默认图片描述模型；该模型需要支持视觉输入。",
                "default": ""
            },
            "caption_timeout": {
                "description": "单张描述超时（秒）",
                "type": "float",
                "hint": "超过该时间仍没有描述时跳过这张图片，避免拖慢整个克隆。",
                "slider": {"min": 3, "max": 60, "step": 1},
                "default": 15
            },
            "auto_pack": {
                "description": "自动同步 meme_manager 图包",
                "type": "bool",
                "hint": "开启后，克隆时把目标用户的图片/表情包自动加入 meme_manager 的 portrayal_QQ号 人格图包，并在后台启动语义化。需要安装并启用 meme_manager。",
                "default": true
            },
            "pack_category": {
                "description": "图包分类名",
                "type": "string",
                "hint": "自动建包时使用的分类目录名，默认「克隆表情」。",
                "default": "克隆表情"
            },
            "pack_max_images": {
                "description": "每次最多入包图片数",
                "type": "int",
                "hint": "每次克隆最多下载多少张图片/表情包到图包；0 表示不入包。",
                "slider": {"min": 0, "max": 100, "step": 1},
                "default": 30
            }
        }
    },
    "clone": {
        "description": "克隆人格行为边界",
        "type": "object",
        "hint": "控制克隆人格的表达强度和禁止行为；每次切换人格时生效。",
        "items": {
            "guardrail_enable": {
                "description": "启用人格行为边界",
                "type": "bool",
                "hint": "开启后，切换人格会在克隆提示词后追加禁止辱骂、人身攻击、歧视、威胁和性暗示的边界规则。建议保持开启。",
                "default": true
            },
            "guardrail_text": {
                "description": "自定义行为边界",
                "type": "text",
                "hint": "留空使用内置边界文案；填写后替换整段边界文案。",
                "default": ""
            },
            "aggression": {
                "description": "攻击性强度",
                "type": "string",
                "options": ["soft", "balanced", "original"],
                "labels": ["温和：只傲娇不骂人", "适中：熟人轻度互损", "接近原风格：保留形式但有硬边界"],
                "hint": "控制克隆人格的吐槽/互损强度；行为边界始终优先。默认适中。",
                "default": "balanced"
            }
        }
    },
    "entry_storage": {
        "description": "提示词配置",
        "hint": "可自定义多套提示词，并定义对应触发命令。由此实现不同风格的画像分析",
        "type": "template_list",
        "templates": {
            "default": {
                "name": "提示词条目",
                "items": {
                    "command": {
                        "description": "触发命令",
                        "hint": "定义用什么命令触发本套提示词",
                        "type": "string",
                        "default": "请输入命令"
                    },
                    "need_admin": { 
                        "description": "仅管理员可用",
                        "hint": "是否需要bot管理员权限触发命令",
                        "type": "bool",
                        "default": false
                    },
                    "content": {
                        "description": "提示词内容",
                        "hint": "请填写提示词内容",
                        "type": "text",
                        "default": "请输入提示词"
                    }
                }
            }
        }
    }
}